# openvox-code example configuration
# See https://slauger.github.io/openvox-code/reference/configuration/ for full reference.

# Required: directory for bare clone Git caches
cachedir: /var/cache/openvox-code

# Required: staging directory for Puppet environments
# For OCI workflow (recommended): use a temp directory, environments are packaged into an image
# For legacy workflow (like r10k): use /etc/puppetlabs/code/environments
environmentdir: /tmp/openvox-code/environments

# Optional: control repository sources for branch-based environment discovery
# Each branch becomes a Puppet environment automatically.
# The branch content (manifests/, hieradata/, data/) is checked out as the environment base.
# If modulefile is set, modules are read from that file inside each branch.
sources:
  - url: https://github.com/example/puppet-control-repo.git
    branches: all
    modulefile: modules.yaml  # per-branch module definitions
    # Or specify branches explicitly:
    # branches:
    #   - production
    #   - staging
    #   - development

# Optional: reusable named groups of modules
# These are deployed globally unless excluded per-environment via modules.yaml
modulesets:
  base:
    - name: stdlib
      git: https://github.com/puppetlabs/puppetlabs-stdlib.git
      ref: v9.7.0
    - name: concat
      git: https://github.com/puppetlabs/puppetlabs-concat.git
      ref: v9.1.0
    - name: firewall
      git: https://github.com/puppetlabs/puppetlabs-firewall.git
      ref: v8.1.3

  webservers:
    - name: apache
      git: https://github.com/puppetlabs/puppetlabs-apache.git
      ref: v12.2.0
    - name: nginx
      git: https://github.com/puppet/puppet-nginx.git
      ref: v5.0.0

# Optional: explicitly declared environments (overrides branch discovery)
environments:
  production:
    ref: v1.5.0
    modulesets:
      - base
      - webservers
  staging:
    ref: staging
    modulesets:
      - base
    modules:
      # Custom target directory: install into site-modules/ instead of modules/
      - name: myapp
        git: https://github.com/example/puppet-myapp.git
        ref: main
        target_dir: site-modules  # parent directory (default: "modules")
      # Custom install name: directory name differs from module name
      - name: apache
        git: https://github.com/puppetlabs/puppetlabs-apache.git
        ref: main
        install_as: httpd  # installed as modules/httpd/ instead of modules/apache/

# Per-branch module file (modules.yaml inside the control repo):
#
# modules:
#   - name: stdlib
#     git: https://github.com/puppetlabs/puppetlabs-stdlib.git
#     ref: v9.7.0
#   - name: myapp
#     git: https://github.com/example/puppet-myapp.git
#     ref: main
#     target_dir: site-modules
#
# exclude:
#   - firewall  # remove this global module from this environment

# Optional: Git authentication
# git:
#   ssh_key: /path/to/id_ed25519
#   ssh_known_hosts: /path/to/known_hosts
#   credential_helper: store  # or: cache, /path/to/helper

# Optional: host-specific Git mirrors (checked before global fallback)
# overrides:
#   gitmirrors:
#     github.com: https://github-mirror.internal.example.com
#     gitlab.com: https://gitlab-mirror.internal.example.com
#   gitmirror: https://fallback-mirror.internal.example.com  # global fallback

# Optional: skip network operations (deploy from cache only)
# offline: true

# Optional: OCI image output (for use with openvox-operator)
# oci:
#   registry: ghcr.io/example/puppet-environments
#   tag: latest
#   auth_config: /path/to/docker/config.json  # or use $DOCKER_CONFIG
