apiVersion: openvox.voxpupuli.org/v1alpha1
kind: CodeConfig
spec:
  # Required: directory for bare clone Git caches
  cachedir: /var/cache/openvox-code

  # Required: staging directory for Puppet environments
  # For OCI workflow (recommended): use a temp directory, environments are packaged into an image
  # For legacy workflow (like r10k): use /etc/puppetlabs/code/environments
  environmentdir: /tmp/openvox-code/environments

  # Control repository sources for branch-based environment discovery
  # The branch content (manifests/, hieradata/, data/) is checked out as the environment base.
  sources:
    - url: https://github.com/example/puppet-control-repo.git

      # Branch selector with glob pattern matching
      # Empty selector = all branches (like r10k branches: all)
      branchSelector:
        matchPatterns:
          - "production"
          - "staging"
          - "feature/*"      # all feature branches
          - "release-*"      # all release branches
        excludePatterns:
          - "feature/wip-*"  # exclude work-in-progress branches

      # Global modules for all environments from this source
      # These are deployed unless overridden or excluded by per-branch module files
      modulesets: [base]

      # Additional inline modules for all branches from this source
      # modules:
      #   - name: site_utils
      #     git: https://github.com/example/puppet-site-utils.git
      #     follow_branch: true
      #     ref: main

      # Per-branch module files (read from inside the checked-out branch)
      # Each branch can define its own modules, overriding the global ones above
      modulefiles:
        - name: modules.yaml
          required: true
        - name: "modules.d/*.yaml"
          required: false

  # Reusable named groups of modules (deployed globally unless excluded per-environment)
  modulesets:
    base:
      - name: stdlib
        git: https://github.com/puppetlabs/puppetlabs-stdlib.git
        ref: v9.7.0
      - name: concat
        git: https://github.com/puppetlabs/puppetlabs-concat.git
        ref: v9.1.0
      - name: firewall
        git: https://github.com/puppetlabs/puppetlabs-firewall.git
        ref: v8.1.3

    webservers:
      - name: apache
        git: https://github.com/puppetlabs/puppetlabs-apache.git
        ref: v12.2.0
      - name: nginx
        git: https://github.com/puppet/puppet-nginx.git
        ref: v5.0.0

  # Explicitly declared environments (overrides branch discovery)
  environments:
    production:
      ref: v1.5.0
      modulesets:
        - base
        - webservers
    staging:
      ref: staging
      modulesets:
        - base
      modules:
        # Custom target directory: install into site-modules/ instead of modules/
        - name: myapp
          git: https://github.com/example/puppet-myapp.git
          ref: main
          target_dir: site-modules
        # Custom install name: directory name differs from module name
        - name: apache
          git: https://github.com/puppetlabs/puppetlabs-apache.git
          ref: main
          install_as: httpd  # installed as modules/httpd/

  # Per-branch module file format (modules.yaml inside the control repo):
  #
  # apiVersion: openvox.voxpupuli.org/v1alpha1
  # kind: ModuleFile
  # spec:
  #   modules:
  #     # Pinned version
  #     - name: stdlib
  #       git: https://github.com/puppetlabs/puppetlabs-stdlib.git
  #       ref: v9.7.0
  #
  #     # Always HEAD (no ref = default branch of the repo)
  #     - name: internal_module
  #       git: https://git.internal/puppet/internal.git
  #
  #     # follow_branch: try environment branch first, ref as fallback
  #     - name: profiles
  #       git: https://github.com/example/puppet-profiles.git
  #       follow_branch: true
  #       ref: main
  #
  #     # Custom target directory
  #     - name: myapp
  #       git: https://github.com/example/puppet-myapp.git
  #       ref: main
  #       target_dir: site-modules
  #
  #   exclude:
  #     - firewall  # remove this global module from this environment

  # Git authentication (default credentials for all repos)
  # git:
  #   ssh_key: /path/to/default_id_ed25519
  #   ssh_known_hosts: /path/to/known_hosts
  #   credential_helper: store
  #
  #   # Per-host credentials (override defaults for specific Git servers)
  #   credentials:
  #     github.com:
  #       ssh_key: /path/to/github_deploy_key
  #     gitlab.internal:
  #       ssh_key: /path/to/gitlab_key
  #       ssh_known_hosts: /path/to/gitlab_known_hosts
  #       credential_helper: cache

  # Host-specific Git mirrors (checked before global fallback)
  # overrides:
  #   gitmirrors:
  #     github.com: https://github-mirror.internal.example.com
  #     gitlab.com: https://gitlab-mirror.internal.example.com
  #   gitmirror: https://fallback-mirror.internal.example.com

  # Skip network operations (deploy from cache only)
  # offline: true

  # OCI image output (for use with openvox-operator)
  # oci:
  #   registry: ghcr.io/example/puppet-environments
  #   tag: latest
  #   auth_config: /path/to/docker/config.json
