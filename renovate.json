{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "description": "Tool versions annotated with a renovate comment in workflows (golangci-lint)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+)\\s+version: (?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "description": "semantic-release packages installed with npm in the release workflow",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/release\\.yaml$/"
      ],
      "matchStrings": [
        "\\s(?<depName>semantic-release|@semantic-release/[a-z-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go dependencies",
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Container base images"
    },
    {
      "description": "golangci-lint pinned in the Go workflow; new linters can report new findings, so keep it out of the Actions group",
      "matchDepNames": [
        "golangci/golangci-lint"
      ],
      "groupName": "golangci-lint"
    },
    {
      "description": "After the manager groups, otherwise gomod/dockerfile grouping wins and the toolchain ends up in Go dependencies; go.mod toolchain and the Containerfile builder image move together; fix marks it as releasable so the next release ships rebuilt binaries",
      "matchDepNames": [
        "go",
        "golang",
        "docker.io/library/golang"
      ],
      "groupName": "Go version",
      "semanticCommitType": "fix"
    },
    {
      "description": "semantic-release and its plugins together; majors may raise the minimum Node.js version",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "npm"
      ],
      "groupName": "semantic-release"
    },
    {
      "description": "Node.js only runs semantic-release; keep majors separate and manual (semantic-release sets the minimum Node version)",
      "matchDepNames": [
        "node"
      ],
      "groupName": "Node.js"
    },
    {
      "description": "Automerge GitHub Actions minor/patch and digest updates (majors stay manual)",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "!node"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge Go toolchain patch releases (standard library security fixes, checked by govulncheck)",
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "toolchain"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Automerge Go module patch/digest updates (minor/major stay manual)",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require",
        "indirect"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true
    }
  ]
}
